{
  "name": "lorchess",
  "version": "0.5.0",
  "description": "Chess web app — play LorFish (AI) or other users in real time.",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/**/*.test.js\"",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.js",
    "user:password": "node --env-file-if-exists=.env src/db/setPassword.js",
    "puzzles:import": "node --env-file-if-exists=.env src/db/importPuzzles.js",
    "achievements:backfill": "node --env-file-if-exists=.env src/achievements/backfill.js",
    "promo:new": "node --env-file-if-exists=.env src/db/promoCodes.js"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "better-sqlite3": "12.11.1",
    "better-sqlite3-session-store": "0.1.0",
    "express": "5.1.0",
    "express-session": "1.19.0",
    "socket.io": "4.8.3",
    "socket.io-parser": "4.2.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "argon2@0.44.0": true
  }
}
